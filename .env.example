# Copia este archivo como .env y ajusta los valores. NUNCA subas el .env a GitHub.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-algo-largo-y-aleatorio
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Base de datos (PostgreSQL con Docker) ---
# Si NO quieres usar Docker, borra o comenta estas 5 lineas y el backend usa SQLite.
POSTGRES_DB=sabe
POSTGRES_USER=sabe
POSTGRES_PASSWORD=sabe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
