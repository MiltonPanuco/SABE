# Producción (F12). Copia como .env.prod en el servidor (chmod 600). NUNCA se sube a GitHub.
# Genera las claves con:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DJANGO_SECRET_KEY=pon-aqui-una-clave-de-50-caracteres-o-mas
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=sabe.163-192-148-141.sslip.io
CSRF_TRUSTED_ORIGINS=https://sabe.163-192-148-141.sslip.io
CORS_ALLOWED_ORIGINS=https://sabe.163-192-148-141.sslip.io
# Un día; súbelo cuando el HTTPS lleve tiempo estable.
SECURE_HSTS_SECONDS=86400

# --- PostgreSQL (servicio "db" del compose) ---
POSTGRES_DB=sabe
POSTGRES_USER=sabe
POSTGRES_PASSWORD=pon-aqui-otra-clave-larga
POSTGRES_PORT=5432

# --- Caddy ---
# Dominio público: Caddy obtiene y renueva el certificado HTTPS. ":80" para probar sin HTTPS.
SABE_DOMINIO=sabe.163-192-148-141.sslip.io

# --- Demostración ---
# Contraseña del usuario "admin" que deja seed_demo (los demás usan demo1234).
SABE_ADMIN_PASSWORD=pon-aqui-una-clave-larga
